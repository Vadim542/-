        "import numpy as np\n",
        "from scipy.integrate import solve_ivp\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "\"\"\"\n",
        "Модель \"хищник-жертва\" Лотки-Вольтерра\n",
        "Система двух дифференциальных уравнений:\n",
        "1. dx/dt = alpha*x - beta*x*y  (жертвы)\n",
        "2. dy/dt = delta*x*y - gamma*y (хищники)\n",
        "где:\n",
        "x - количество жертв\n",
        "y - количество хищников\n",
        "alpha - скорость размножения жертв\n",
        "beta - скорость поедания жертв хищниками\n",
        "delta - скорость размножения хищников\n",
        "gamma - смертность хищников\n",
        "\"\"\"\n",
        "\n",
        "# Параметры модели\n",
        "alpha = 1.1   # Скорость размножения жертв\n",
        "beta = 0.4    # Скорость поедания жертв\n",
        "delta = 0.1   # Скорость размножения хищников\n",
        "gamma = 0.4   # Смертность хищников\n",
        "\n",
        "# Система дифференциальных уравнений\n",
        "def predator_prey(t, z):\n",
        "    x, y = z\n",
        "    dxdt = alpha*x - beta*x*y\n",
        "    dydt = delta*x*y - gamma*y\n",
        "    return [dxdt, dydt]\n",
        "\n",
        "# Начальные условия\n",
        "initial_prey = 20     # Начальное количество жертв\n",
        "initial_predator = 5  # Начальное количество хищников\n",
        "initial_conditions = [initial_prey, initial_predator]\n",
        "\n",
        "# Временной интервал (0-50 дней)\n",
        "t_start = 0\n",
        "t_end = 50\n",
        "t_points = np.linspace(t_start, t_end, 500)\n",
        "\n",
        "# Решение системы ОДУ\n",
        "solution = solve_ivp(predator_prey,\n",
        "                    [t_start, t_end],\n",
        "                    initial_conditions,\n",
        "                    t_eval=t_points)\n",
        "\n",
        "# Извлечение результатов\n",
        "t = solution.t\n",
        "prey = solution.y[0]  # Популяция жертв\n",
        "predator = solution.y[1]  # Популяция хищников\n",
        "\n",
        "# Построение графика динамики популяций\n",
        "plt.figure(figsize=(10, 6))\n",
        "plt.plot(t, prey, 'g-', label='Жертвы (x)')\n",
        "plt.plot(t, predator, 'r-', label='Хищники (y)')\n",
        "\n",
        "# Настройка оформления\n",
        "plt.xlabel('Время (дни)', fontsize=12)\n",
        "plt.ylabel('Популяция', fontsize=12)\n",
        "plt.title('Динамика популяций \"хищник-жертва\"', fontsize=14)\n",
        "plt.grid(True, linestyle='--', alpha=0.7)\n",
        "plt.legend(fontsize=10)\n",
        "\n",
        "# Отображение графика\n",
        "plt.show()\n",
        "\n",
        "# Дополнительно: фазовый портрет системы\n",
        "plt.figure(figsize=(8, 6))\n",
        "plt.plot(prey, predator, 'b-')\n",
        "plt.xlabel('Жертвы (x)', fontsize=12)\n",
        "plt.ylabel('Хищники (y)', fontsize=12)\n",
        "plt.title('Фазовый портрет системы', fontsize=14)\n",
        "plt.grid(True, linestyle='--', alpha=0.7)\n",
        "plt.show()"
      ]
    }
